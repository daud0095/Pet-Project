@startuml
!pragma layout smetana
class User{
  name
  email
  password
}

class Student{
  studentID
}

class Admin{
}

class Product{
  productID
  name
  description
  status
}

class Loan{
  loanDate
  dueDate
  returnDate
}

class Reservation{
  fromDate
  toDate
}

User <|-- Student
User <|-- Admin

Student "1" -- "0..*" Loan
Loan "0..*" -- "1" Product
Student "1" -- "0..*" Reservation
Reservation "0..*" -- "1" Product

Admin "1" -- "0..*" Product : manages
@enduml